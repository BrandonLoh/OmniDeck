# OmniDeck 服务端环境变量示例
# 复制为 .env 放在 server/ 目录（与 docker-compose.yml 同级），docker compose 会自动读取

# --- 端口 ---
# 宿主机映射端口（容器内固定 8080）。默认 8081，因为 NAS 的 8080 常被 DSM 占用
OMNIDECK_PORT=8081

# --- AI 播报（全部可选） ---
# 不配置时: LLM 回退本地模板文案，TTS 返回空（固件只播铃声，屏幕显示文案）

# OpenAI 兼容 LLM（任何中转/本地 Ollama-openai 均可）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# OpenAI 兼容 TTS
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com
TTS_MODEL=tts-1
TTS_VOICE=alloy
